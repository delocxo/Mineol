<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
  <None Include="..\Mineol.Templates\Runtime\**\*.cs">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <TargetPath>Templates\Runtime\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
  </None>

  <None Include="..\Mineol.Templates\Natives\**\*.cs">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <TargetPath>Templates\Natives\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
  </None>
</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
